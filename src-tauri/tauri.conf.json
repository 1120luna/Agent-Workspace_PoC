{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentWorkspace",
  "version": "0.1.0",
  "identifier": "com.agentworkspace.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Workspace",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/sidecar"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}

